rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Room Entity Validation
    function isValidRoom(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.code is string && data.code.size() <= 10 &&
             data.gameType in ['pisti', 'batak'] &&
             data.maxPlayers in [2, 4] &&
             data.status in ['waiting', 'dealing', 'bidding', 'playing', 'round_ended', 'game_over'] &&
             data.hostId is string && data.hostId.size() <= 64;
    }

    // Room Player Entity Validation
    function isValidPlayer(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.roomId is string && data.roomId.size() <= 64 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 32 &&
             data.seatIndex is number && data.seatIndex >= 0 && data.seatIndex <= 3;
    }

    // Hand Telemetry Validation
    function isValidTelemetry(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.roomId is string && data.roomId.size() <= 64 &&
             data.playerId is string && data.playerId.size() <= 64;
    }

    // Voice Signal Validation
    function isValidSignal(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.roomId is string && data.roomId.size() <= 64 &&
             data.senderId is string && data.senderId.size() <= 64 &&
             data.receiverId is string && data.receiverId.size() <= 64 &&
             data.type in ['offer', 'answer', 'candidate'] &&
             data.payload is string && data.payload.size() <= 2048;
    }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 32;
    }

    // Rooms Collection
    match /rooms/{roomId} {
      allow read: if isValidId(roomId);
      allow create: if isSignedIn() && isValidId(roomId) && isValidRoom(incoming()) && incoming().hostId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(roomId) && isValidRoom(incoming());
      allow delete: if isSignedIn() && isValidId(roomId) && existing().hostId == request.auth.uid;

      // Players subcollection
      match /players/{playerId} {
        allow read: if isValidId(roomId) && isValidId(playerId);
        allow create: if isSignedIn() && isValidId(roomId) && isValidId(playerId) && isValidPlayer(incoming());
        allow update: if isSignedIn() && isValidId(roomId) && isValidId(playerId) && isValidPlayer(incoming());
        allow delete: if isSignedIn() && isValidId(roomId) && isValidId(playerId);
      }

      // Hand Telemetry subcollection (for VR Quest 3 motion tracking telemetry logging)
      match /telemetry/{telemetryId} {
        allow read: if isValidId(roomId) && isValidId(telemetryId);
        allow create: if isSignedIn() && isValidId(roomId) && isValidId(telemetryId) && isValidTelemetry(incoming());
        allow update: if isSignedIn() && isValidId(roomId) && isValidId(telemetryId) && isValidTelemetry(incoming());
        allow delete: if isSignedIn() && isValidId(roomId) && isValidId(telemetryId);
      }

      // Voice Signals subcollection (for WebRTC Mesh Spatial Audio Signaling)
      match /signals/{signalId} {
        allow read: if isValidId(roomId) && isValidId(signalId);
        allow create: if isSignedIn() && isValidId(roomId) && isValidId(signalId) && isValidSignal(incoming());
        allow delete: if isSignedIn() && isValidId(roomId) && isValidId(signalId);
      }
    }

    // User Profiles Collection
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserProfile(incoming());
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserProfile(incoming());
    }
  }
}
