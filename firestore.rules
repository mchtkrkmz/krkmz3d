rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64;
    }

    // Rooms Collection for multiplayer Pişti & Batak
    match /rooms/{roomId} {
      allow read, write: if isValidId(roomId);

      // Players in the room
      match /players/{playerId} {
        allow read, write: if isValidId(roomId) && isValidId(playerId);
      }

      // Hand Tracking Telemetry (Quest 3 hand motions & pinch metrics)
      match /telemetry/{telemetryId} {
        allow read, write: if isValidId(roomId) && isValidId(telemetryId);
      }

      // Voice chat WebRTC signals
      match /signals/{signalId} {
        allow read, write: if isValidId(roomId) && isValidId(signalId);
      }
    }

    // Public user stats
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }
  }
}
